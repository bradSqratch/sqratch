  failedAttempts  Int       @default(0)
  consumedAt      DateTime?
  expires         DateTime
  createdAt       DateTime  @default(now())
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([email])
  @@index([userId, consumedAt, expires])
  @@index([email, consumedAt, expires])
