/// The SQRATCH surface a commerce click physically originated from, persisted on
/// `CommerceClickAttribution.surface` so the classification survives the later
/// deletion of the rows it was derived from.
///
/// These are exactly the three variants of the `CommerceClickSurface`
/// discriminated union in `src/lib/commerce/click-attribution.ts`, which is the
/// single place a surface is constructed. Adding a value here without adding it
/// there (or vice versa) is a bug: the two must stay one-to-one.
enum CommerceClickSurface {
  /// A brand's generic Experience storefront listing. Carries no campaign scope.
  BRAND_STOREFRONT
  /// A campaign-curated product (`CampaignCommerceProduct` assignment).
  CAMPAIGN_PRODUCT
  /// A product attached to a lesson (`CampaignLessonProduct`).
  LESSON
}

