/// Provider-neutral payment state of a `CommerceOrder`. Any provider value
/// that does not map cleanly onto one of these (e.g. Shopify's `expired`) is
/// normalized to `null` — never guessed into the nearest-looking member.
enum CommerceOrderFinancialStatus {
  PENDING
  AUTHORIZED
  PARTIALLY_PAID
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  VOIDED
}

/// Provider-neutral fulfillment state. Shopify reports `null` for an
/// unfulfilled order rather than the string "unfulfilled"; the normalizer maps
/// that absence to `UNFULFILLED` only when the payload is otherwise a
/// well-formed order, and to `null` when the field is genuinely unknown.
enum CommerceOrderFulfillmentStatus {
  UNFULFILLED
  PARTIALLY_FULFILLED
  FULFILLED
  RESTOCKED
}

/// Terminal disposition of one received provider order event.
/// RECEIVED              — row written, processing not yet finished.
/// PROCESSED             — the order row was created or updated.
/// SKIPPED_STALE         — a newer state for this order is already stored.
/// SKIPPED_DISCONNECTED  — the shop is not in a connected state; recorded, not applied.
/// FAILED                — processing threw; the event is retained as evidence.
enum CommerceOrderEventStatus {
  RECEIVED
  PROCESSED
  SKIPPED_STALE
  SKIPPED_DISCONNECTED
  FAILED
}
