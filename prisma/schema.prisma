generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                        String                     @id @default(cuid())
  name                      String?
  email                     String                     @unique
  isEmailVerified           Boolean                    @default(false)
  emailVerifiedAt           DateTime?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  password                  String?
  sessionVersion            Int                        @default(0)
  role                      Role                       @default(USER)
  isActive                  Boolean                    @default(true)
  imageUrl                  String?
  pointAccount              UserPointAccount?
  analyticsEvents           AnalyticsEvent[]
  brandMembers              BrandMember[]
  reviewedBrandRequests     BrandRequest[]             @relation("BrandRequestReviewer")
  brandRequests             BrandRequest[]             @relation("BrandRequestOwner")
  campaigns                 Campaign[]                 @relation("CampaignCreatedByUser")
  campaignUnlocks           CampaignUnlock[]
  creatorProfile            CreatorProfile?
  reviewedCreatorRequests   CreatorRequest[]           @relation("CreatorRequestReviewer")
  creatorRequests           CreatorRequest[]           @relation("CreatorRequestOwner")
  emailQueue                EmailQueue[]
  emailVerificationTokens   EmailVerificationToken[]
  lessonProgress            LessonProgress[]
  pointTransactions         PointTransaction[]
  postComments              PostComment[]
  qrCodesCreated            QRCode[]                   @relation("QRCodeCreatedByUser")
  qrRedemptions             QRCode[]                   @relation("QRCodeRedeemedByUser")
  questions                 Question[]
  questionAnswers           QuestionAnswer[]
  commerceRewardRedemptions CommerceRewardRedemption[]
  sessions                  UserSession[]
  commerceClickAttributions CommerceClickAttribution[]
}

model CreatorRequest {
  id           String         @id @default(cuid())
  userId       String
  status       ApprovalStatus @default(PENDING)
  reason       String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  reviewedById String?
  reviewedBy   User?          @relation("CreatorRequestReviewer", fields: [reviewedById], references: [id])
  user         User           @relation("CreatorRequestOwner", fields: [userId], references: [id], onDelete: Cascade)
}

model BrandRequest {
  id                String         @id @default(cuid())
  userId            String
  status            ApprovalStatus @default(PENDING)
  reason            String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  proposedBrandName String?
  proposedStoreUrl  String?
  reviewedById      String?
  reviewedBy        User?          @relation("BrandRequestReviewer", fields: [reviewedById], references: [id])
  user              User           @relation("BrandRequestOwner", fields: [userId], references: [id], onDelete: Cascade)
}

model CreatorProfile {
  id          String       @id @default(cuid())
  userId      String       @unique
  displayName String?
  bio         String?
  avatarUrl   String?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  experiences Experience[]

  commerceClickAttributions CommerceClickAttribution[]
}

model Brand {
  id                                String                             @id @default(cuid())
  name                              String                             @unique
  slug                              String                             @unique
  bio                               String?
  websiteUrl                        String?
  logoUrl                           String?
  isActive                          Boolean                            @default(true)
  createdAt                         DateTime                           @default(now())
  updatedAt                         DateTime                           @updatedAt
  coverImageUrl                     String?
  analyticsEvents                   AnalyticsEvent[]
  members                           BrandMember[]
  campaigns                         Campaign[]
  rewardOffers                      BrandRewardOffer[]
  commerceRewardRedemptions         CommerceRewardRedemption[]
  commerceConnectionEvents          CommerceConnectionEvent[]
  commerceConnections               CommerceConnection[]
  connectedCommerceProducts         ConnectedCommerceProduct[]
  commerceProductSyncRuns           CommerceProductSyncRun[]
  brandCommerceProducts             BrandCommerceProduct[]
  campaignCommerceProducts          CampaignCommerceProduct[]
  campaignLessonProducts            CampaignLessonProduct[]
  commerceOrders                    CommerceOrder[]
  commerceOrderEvents               CommerceOrderEvent[]
  commerceOrderReconciliationStates CommerceOrderReconciliationState[]
}

model BrandMember {
  id        String          @id @default(cuid())
  brandId   String
  userId    String
  role      BrandMemberRole @default(ADMIN)
  createdAt DateTime        @default(now())
  brand     Brand           @relation(fields: [brandId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([brandId, userId])
  @@index([userId])
  @@index([brandId])
}

model Campaign {
  id                               String                     @id @default(cuid())
  name                             String                     @unique
  description                      String?
  inviteUrl                        String?
  createdAt                        DateTime                   @default(now())
  updatedAt                        DateTime                   @updatedAt
  createdById                      String
  isActive                         Boolean                    @default(true)
  /// Canonical immutable Campaign owner. A database trigger rejects any
  /// reassignment after insert; application routes enforce the same rule.
  brandId                          String
  slug                             String                     @unique
  analyticsEvents                  AnalyticsEvent[]
  brand                            Brand                      @relation(fields: [brandId], references: [id])
  createdBy                        User                       @relation("CampaignCreatedByUser", fields: [createdById], references: [id])
  experiences                      CampaignExperience[]
  unlocks                          CampaignUnlock[]
  qrCodes                          QRCode[]
  qrBatches                        QRCodeBatch[]
  userSessions                     UserSession[]
  commerceProductAssignments       CampaignCommerceProduct[]
  lessonProductAssignments         CampaignLessonProduct[]
  entryCommerceClickAttributions   CommerceClickAttribution[] @relation("CommerceClickAttributionEntryCampaign")
  productCommerceClickAttributions CommerceClickAttribution[] @relation("CommerceClickAttributionProductCampaign")

  // Supports the Phase-4 same-brand composite FKs from CampaignCommerceProduct
  // and CampaignLessonProduct. Keep this key: those assignments use it to
  // enforce same-Brand tenant integrity.
  @@unique([id, brandId])
  @@index([brandId])
}

model QRCodeBatch {
  id            String    @id @default(cuid())
  name          String
  notes         String?
  printedAt     DateTime?
  isActive      Boolean   @default(true)
  campaignId    String?
  createdAt     DateTime  @default(now())
  csvExportedAt DateTime?
  qrCodes       QRCode[]
  campaign      Campaign? @relation(fields: [campaignId], references: [id])

  @@index([campaignId])
}

model QRCode {
  id                        String                     @id @default(cuid())
  qrCodeData                String                     @unique
  status                    QRStatus                   @default(NEW)
  qrCodeUrl                 String?
  email                     String?
  usedAt                    DateTime?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  campaignId                String
  redeemedById              String?
  createdById               String
  isActive                  Boolean                    @default(true)
  batchId                   String?
  analyticsEvents           AnalyticsEvent[]
  unlocks                   CampaignUnlock[]
  pointTransactions         PointTransaction[]
  batch                     QRCodeBatch?               @relation(fields: [batchId], references: [id])
  campaign                  Campaign                   @relation(fields: [campaignId], references: [id])
  createdBy                 User                       @relation("QRCodeCreatedByUser", fields: [createdById], references: [id])
  redeemedBy                User?                      @relation("QRCodeRedeemedByUser", fields: [redeemedById], references: [id])
  userSessions              UserSession[]
  commerceClickAttributions CommerceClickAttribution[]

  @@index([campaignId])
  @@index([batchId])
  @@index([redeemedById])
}

model CampaignUnlock {
  id         String   @id @default(cuid())
  campaignId String
  userId     String?
  qrCodeId   String?
  anonKey    String?
  createdAt  DateTime @default(now())
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  qrCode     QRCode?  @relation(fields: [qrCodeId], references: [id])
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  commerceClickAttributions CommerceClickAttribution[]

  @@unique([campaignId, userId])
  @@index([campaignId])
  @@index([userId])
  @@index([anonKey])
  @@index([anonKey, campaignId])
}

model Experience {
  id                        String                     @id @default(cuid())
  title                     String
  slug                      String                     @unique
  description               String?
  coverImageUrl             String?
  whyVideoSource            ExperienceVideoSource?
  whyYoutubeUrl             String?
  whyVideoUploadUrl         String?
  isActive                  Boolean                    @default(true)
  creatorId                 String
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  qaDailyQuestionLimit      Int                        @default(1)
  analyticsEvents           AnalyticsEvent[]
  campaigns                 CampaignExperience[]
  courses                   Course[]
  creator                   CreatorProfile             @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  posts                     Post[]
  questions                 Question[]
  commerceClickAttributions CommerceClickAttribution[]

  @@index([creatorId])
}

model CampaignExperience {
  id           String     @id @default(cuid())
  campaignId   String
  experienceId String
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now())
  campaign     Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@unique([campaignId, experienceId])
  @@index([campaignId])
  @@index([experienceId])
  @@index([experienceId, sortOrder])
}

model Course {
  id                        String                     @id @default(cuid())
  experienceId              String
  title                     String
  description               String?
  access                    CourseAccess               @default(PUBLIC)
  sortOrder                 Int                        @default(0)
  isActive                  Boolean                    @default(true)
  completionPointsReward    Int                        @default(0)
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  analyticsEvents           AnalyticsEvent[]
  experience                Experience                 @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  lessons                   Lesson[]
  commerceClickAttributions CommerceClickAttribution[]

  @@index([experienceId])
  @@index([access])
  @@index([experienceId, isActive, sortOrder, createdAt])
  @@index([experienceId, isActive, access, sortOrder, createdAt])
}

model Lesson {
  id                        String                     @id @default(cuid())
  courseId                  String
  title                     String
  description               String?
  sortOrder                 Int                        @default(0)
  isActive                  Boolean                    @default(true)
  completionPointsReward    Int                        @default(0)
  videoSource               LessonVideoSource          @default(YOUTUBE)
  youtubeUrl                String?
  videoUploadUrl            String?
  videoStorageBucket        String?
  videoStoragePath          String?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  analyticsEvents           AnalyticsEvent[]
  course                    Course                     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  campaignProducts          CampaignLessonProduct[]
  progress                  LessonProgress[]
  commerceClickAttributions CommerceClickAttribution[]

  @@index([courseId])
  @@index([courseId, isActive, sortOrder, createdAt])
}

model LessonProgress {
  id                  String       @id @default(cuid())
  userId              String?
  lessonId            String
  isCompleted         Boolean      @default(false)
  lastPositionSeconds Int          @default(0)
  updatedAt           DateTime     @updatedAt
  createdAt           DateTime     @default(now())
  sessionId           String?
  lesson              Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  session             UserSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user                User?        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@unique([sessionId, lessonId])
  @@index([lessonId])
  @@index([userId])
  @@index([sessionId])
}

model Post {
  id           String        @id @default(cuid())
  experienceId String
  title        String?
  body         String
  isPinned     Boolean       @default(false)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  experience   Experience    @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  comments     PostComment[]

  @@index([experienceId])
  @@index([experienceId, isActive])
}

model PostComment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  body      String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([userId])
}

model Question {
  id           String           @id @default(cuid())
  experienceId String
  askedById    String
  body         String
  status       QuestionStatus   @default(OPEN)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  askedBy      User             @relation(fields: [askedById], references: [id], onDelete: Cascade)
  experience   Experience       @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  answers      QuestionAnswer[]

  @@index([experienceId])
  @@index([askedById])
}

model QuestionAnswer {
  id           String   @id @default(cuid())
  questionId   String
  answeredById String
  body         String
  createdAt    DateTime @default(now())
  answeredBy   User     @relation(fields: [answeredById], references: [id], onDelete: Cascade)
  question     Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@index([answeredById])
}

// PHASE 8 TOMBSTONE: the `ExperienceProductLink` and `LessonProductLink`
// models used to be declared here. They were free-form, creator-typed product SNAPSHOT tables whose
// rows carried their own productUrl/title/imageUrl/priceText/currency and had no
// provider-verified identity, no brand ownership guarantee, and no campaign
// scoping. Both are removed by
// 20260808130000_remove_legacy_product_link_snapshots. The canonical replacement
// chain is Brand -> CommerceConnection -> ConnectedCommerceProduct ->
// BrandCommerceProduct -> CampaignCommerceProduct -> CampaignLessonProduct.

model BrandRewardOffer {
  id                            String                     @id @default(cuid())
  brandId                       String
  /// Required explicitly by every writer; no provider may silently inherit
  /// Shopify identity from a database default.
  provider                      CommerceProvider
  title                         String
  description                   String?
  isActive                      Boolean                    @default(false)
  pointsCost                    Int
  discountType                  RewardDiscountType         @default(FIXED_AMOUNT)
  discountAmountCents           Int?
  discountPercentageBasisPoints Int?
  currencyCode                  String                     @default("CAD")
  claimStartsAt                 DateTime?
  claimEndsAt                   DateTime?
  codeValidDays                 Int                        @default(30)
  appliesTo                     RewardAppliesTo            @default(ALL_PRODUCTS)
  minimumSubtotalCents          Int?
  codePrefix                    String?
  maxTotalRedemptions           Int?
  maxRedemptionsPerUser         Int?
  sourceExternalAccountId       String?                    @map("sourceShopDomain")
  createdAt                     DateTime                   @default(now())
  updatedAt                     DateTime                   @updatedAt
  brand                         Brand                      @relation(fields: [brandId], references: [id], onDelete: Cascade)
  products                      BrandRewardOfferProduct[]
  redemptions                   CommerceRewardRedemption[]

  @@index([brandId])
  @@index([brandId, isActive, claimStartsAt, claimEndsAt])
  @@index([brandId, sourceExternalAccountId], map: "BrandRewardOffer_brandId_sourceShopDomain_idx")
  /// Phase 15C2 resolves an offer's provider-specific source-account snapshot
  /// without treating a brand's current connection as historical authority.
  @@index([brandId, provider, sourceExternalAccountId], map: "BrandRewardOffer_brandId_provider_sourceShopDomain_idx")
}

model BrandRewardOfferProduct {
  id                String           @id @default(cuid())
  offerId           String
  externalProductId String           @map("shopifyProductGid")
  title             String?
  imageUrl          String?
  productUrl        String?
  offer             BrandRewardOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@unique([offerId, externalProductId], map: "BrandRewardOfferProduct_offerId_shopifyProductGid_key")
  @@index([offerId])
}

/// Provider-neutral, append-only lifecycle history. It deliberately snapshots
/// identity rather than depending on a live CommerceConnection FK, so the
/// audit record survives a privacy-driven connection deletion.
model CommerceConnectionEvent {
  id                        String                      @id @default(cuid())
  brandId                   String
  provider                  CommerceProvider
  eventType                 CommerceConnectionEventType
  externalAccountId         String?
  previousExternalAccountId String?
  currencyCode              String?
  previousCurrencyCode      String?
  providerClientId          String?
  createdAt                 DateTime                    @default(now())

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId, createdAt])
  @@index([externalAccountId, createdAt])
  @@index([previousExternalAccountId, createdAt])
}

model CommerceConnection {
  id                        String                            @id @default(cuid())
  brandId                   String
  provider                  CommerceProvider
  status                    CommerceConnectionStatus          @default(DISCONNECTED)
  displayName               String
  externalAccountId         String
  storefrontUrl             String?
  providerClientId          String?
  isPrimary                 Boolean                           @default(false)
  grantedScopes             Json?
  providerMetadata          Json?
  installedAt               DateTime?
  uninstalledAt             DateTime?
  lastProductSyncAt         DateTime?
  createdAt                 DateTime                          @default(now())
  updatedAt                 DateTime                          @updatedAt
  brand                     Brand                             @relation(fields: [brandId], references: [id], onDelete: Cascade)
  secret                    CommerceConnectionSecret?
  connectedProducts         ConnectedCommerceProduct[]
  productSyncRuns           CommerceProductSyncRun[]
  commerceClickAttributions CommerceClickAttribution[]
  commerceOrders            CommerceOrder[]
  commerceOrderEvents       CommerceOrderEvent[]
  orderReconciliationState  CommerceOrderReconciliationState?

  @@unique([provider, externalAccountId])
  @@index([brandId])
  @@index([brandId, provider])
  @@index([brandId, isPrimary])
  @@index([provider, status])
}

model CommerceConnectionSecret {
  id               String    @id @default(cuid())
  connectionId     String    @unique
  encryptedPayload String
  keyVersion       Int       @default(1)
  rotatedAt        DateTime?
  expiresAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  /// Refresh-lease compare-and-swap state. These are FIRST-CLASS COLUMNS, not
  /// fields inside `encryptedPayload`, and that is a correctness requirement
  /// rather than a style choice: `encryptSecret` (src/lib/crypto.ts) is
  /// AES-256-GCM with a random per-call IV, so the same plaintext yields a
  /// different ciphertext every time. A compare-and-swap predicate therefore
  /// cannot be expressed as `WHERE "encryptedPayload" = $expected`, and doing
  /// it as decrypt -> compare -> re-encrypt would be a read-modify-write race —
  /// exactly what the lease exists to prevent. Keeping them as plain columns
  /// lets Postgres arbitrate a single refresh winner in ONE atomic UPDATE,
  /// the same way the legacy `Brand.shopifyTokenRefresh*` columns did.
  /// Provider-neutral by design: any provider whose credential needs
  /// serialized rotation can use the same two columns; a provider that needs
  /// no rotation simply leaves them null.
  refreshLockId      String?
  refreshLockedUntil DateTime?

  connection CommerceConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
}

/// PHASE 16B — provider-neutral record of a provider-side app installation that
/// may not yet be linked to a SQRATCH Brand.
///
/// A Commerce7 (or any future provider) merchant installs the app on their own
/// tenant BEFORE SQRATCH knows which Brand owns it. This model represents
/// exactly that pre-link state and nothing more.
///
/// DELIBERATELY HAS NO `brandId`. Brand ownership authority lives ONLY on
/// `CommerceConnection` — duplicating it here would recreate the two-sources-
/// of-truth class of bug the canonical commerce migration removed. Linking is
/// performed by an authenticated SQRATCH Brand Admin (see
/// `CommerceConnectionLinkIntent`), never inferred from installer identity.
///
/// Holds NO credential material. Commerce7's App Secret is app-global and
/// comes from backend environment configuration, never from the database.
model CommerceProviderInstallation {
  id                String                     @id @default(cuid())
  provider          CommerceProvider
  externalAccountId String
  status            CommerceInstallationStatus @default(INSTALLED)
  installedAt       DateTime                   @default(now())
  uninstalledAt     DateTime?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  linkIntents CommerceConnectionLinkIntent[]

  @@unique([provider, externalAccountId])
  @@index([provider, status])
}

/// PHASE 16B — a short-lived, single-use intent to link an installed provider
/// account to a SQRATCH Brand.
///
/// The raw token is cryptographically random (256 bits), base64url-encoded, and
/// NEVER persisted — only its SHA-256 digest is stored, so a database read can
/// never yield a usable token. Consumption is an atomic compare-and-swap on
/// (tokenHash, consumedAt IS NULL, expiresAt > now), so exactly one concurrent
/// confirmation can win.
///
/// Stores NO provider credential and NO provider account token.
model CommerceConnectionLinkIntent {
  id             String    @id @default(cuid())
  installationId String
  /// SHA-256 hex digest of the raw token. The raw token is never stored.
  tokenHash      String    @unique
  expiresAt      DateTime
  consumedAt     DateTime?
  createdAt      DateTime  @default(now())

  installation CommerceProviderInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)

  @@index([installationId, consumedAt])
  @@index([expiresAt])
}

model ConnectedCommerceProduct {
  id                        String                     @id @default(cuid())
  connectionId              String
  brandId                   String
  provider                  CommerceProvider
  externalKey               String
  externalId                String
  title                     String
  handle                    String?
  productUrl                String
  imageUrl                  String?
  images                    String[]
  externalVariantIds        String[]
  descriptionText           String?
  sku                       String?
  currencyCode              String?
  priceMinMinor             Int?
  priceMaxMinor             Int?
  priceMinorUnitExponent    Int?
  isAvailable               Boolean                    @default(true)
  /// Phase 8.2: records the FACT that the provider confirmed Online Store
  /// publication for this product. Shopify's `Product.onlineStoreUrl` remains
  /// navigation data only: password-protected development stores return null
  /// even for published products, where sync uses a canonical fallback URL.
  /// It is NOT named `isPublished` because it is an intentionally
  /// provider-neutral public-destination gate, not a generic lifecycle field.
  ///
  /// DELIBERATELY DISTINCT FROM `isAvailable`. `isAvailable` encodes provider
  /// inventory/lifecycle status (Shopify `status === ACTIVE`), which is
  /// orthogonal to publication: an ACTIVE unpublished product has no public
  /// destination. Neither
  /// field may be derived from, or substituted for, the other — a public
  /// click destination requires BOTH.
  ///
  /// `false` is the fail-closed default so an unknown publication state can
  /// never be exposed as a clickable public product. Every row that existed
  /// before this column was added therefore reads `false` until the brand
  /// re-runs a product sync.
  hasPublicStorefrontUrl    Boolean                    @default(false)
  firstSeenAt               DateTime                   @default(now())
  lastSeenAt                DateTime                   @default(now())
  unavailableSince          DateTime?
  providerCreatedAt         DateTime?
  providerUpdatedAt         DateTime?
  providerMetadata          Json?
  lastSyncRunId             String?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  connection                CommerceConnection         @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  brand                     Brand                      @relation(fields: [brandId], references: [id], onDelete: Cascade)
  brandSelections           BrandCommerceProduct[]
  commerceClickAttributions CommerceClickAttribution[]
  orderLineItems            CommerceOrderLineItem[]

  @@unique([connectionId, externalKey])
  @@index([connectionId])
  @@index([connectionId, isAvailable])
  @@index([brandId])
  @@index([brandId, isAvailable])
  @@index([connectionId, lastSeenAt])
}

model CommerceProductSyncRun {
  id                     String                       @id @default(cuid())
  connectionId           String
  brandId                String
  provider               CommerceProvider
  status                 CommerceProductSyncRunStatus @default(RUNNING)
  startedAt              DateTime                     @default(now())
  finishedAt             DateTime?
  fetchedCount           Int                          @default(0)
  createdCount           Int                          @default(0)
  updatedCount           Int                          @default(0)
  unchangedCount         Int                          @default(0)
  markedUnavailableCount Int                          @default(0)
  failedCount            Int                          @default(0)
  hasNextPage            Boolean                      @default(false)
  requestedLimit         Int?
  failureSummary         String?
  triggeredBy            String?
  createdAt              DateTime                     @default(now())
  connection             CommerceConnection           @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  brand                  Brand                        @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([connectionId, startedAt])
  @@index([brandId, startedAt])
  @@index([status])
}

model BrandCommerceProduct {
  id                        String                     @id @default(cuid())
  brandId                   String
  connectedProductId        String
  isVisibleInShop           Boolean                    @default(false)
  isCampaignEligible        Boolean                    @default(false)
  displayOrder              Int                        @default(0)
  titleOverride             String?
  shortDescriptionOverride  String?
  imageUrlOverride          String?
  approvedByUserId          String?
  approvedAt                DateTime?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  brand                     Brand                      @relation(fields: [brandId], references: [id], onDelete: Cascade)
  connectedProduct          ConnectedCommerceProduct   @relation(fields: [connectedProductId], references: [id], onDelete: Cascade)
  campaignAssignments       CampaignCommerceProduct[]
  campaignLessonAssignments CampaignLessonProduct[]
  commerceClickAttributions CommerceClickAttribution[]

  @@unique([brandId, connectedProductId])
  // Supports the Phase-4 same-brand composite FK from CampaignCommerceProduct.
  @@unique([id, brandId])
  @@index([brandId, isVisibleInShop, displayOrder])
  @@index([brandId, isCampaignEligible])
  @@index([connectedProductId])
}

/// Provider-neutral assignment of one brand-curated catalog product to one
/// campaign. This is deliberately a single reversible row per
/// (campaign, BrandCommerceProduct): toggling isActive reuses the row, so a
/// duplicate active assignment is structurally impossible and an assignment's
/// history is never deleted or rewritten to express a lifecycle change.
model CampaignCommerceProduct {
  id                     String               @id @default(cuid())
  brandId                String
  campaignId             String
  brandCommerceProductId String
  isActive               Boolean              @default(true)
  displayOrder           Int                  @default(0)
  deactivatedAt          DateTime?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  brand                  Brand                @relation(fields: [brandId], references: [id], onDelete: Cascade)
  // Both composite FKs include brandId. PostgreSQL therefore rejects a
  // cross-brand campaign/product assignment even if callers bypass services.
  campaign               Campaign             @relation(fields: [campaignId, brandId], references: [id, brandId], onDelete: Cascade)
  brandCommerceProduct   BrandCommerceProduct @relation(fields: [brandCommerceProductId, brandId], references: [id, brandId], onDelete: Cascade)

  @@unique([campaignId, brandCommerceProductId])
  @@index([brandId, campaignId, isActive, displayOrder])
  @@index([campaignId, isActive, displayOrder])
  @@index([brandCommerceProductId, isActive])
}

/// THE canonical Lesson product attachment. Campaign-scoped attachment of one
/// brand-curated catalog product to one Lesson.
///
/// This table is the ONLY representation of "a product is attached to this
/// lesson". As of Phase 8 there is no other one: the legacy
/// `LessonProductLink` / `ExperienceProductLink` snapshot tables are gone, and
/// no bridge column to them remains.
///
/// This row carries NO display data of its own. Title, image, price, currency
/// and the outbound product URL all derive from
/// `BrandCommerceProduct -> ConnectedCommerceProduct`, i.e. from
/// provider-verified catalog data that a product sync owns and refreshes. A
/// public, clickable destination additionally requires
/// `ConnectedCommerceProduct.hasPublicStorefrontUrl` — see that field.
///
/// WHY campaignId is on this row (rather than a campaign-less "canonical
/// lesson product"): an Experience can be co-sponsored by several campaigns
/// belonging to several brands. Phase 5E requires that a product attached
/// under Campaign A never renders under Campaign B's context on that shared
/// Experience. Canonicalizing the product alone cannot express that; the
/// scoping has to live on the attachment.
///
/// The same product may therefore be attached under two different campaigns as
/// two independent rows, which is exactly what lets a creator attach Campaign
/// A's product and Campaign B's product (or the same product under both)
/// without the two corrupting each other's attribution.
///
/// `@@unique([campaignId, lessonId, brandCommerceProductId])` is THE reversible
/// lifecycle key. It mirrors CampaignCommerceProduct's "one reversible
/// lifecycle row per tuple, reactivate rather than duplicate" pattern: attach
/// and detach toggle `isActive` on the SAME row, so a duplicate active
/// attachment is structurally impossible and detach/reattach preserves the
/// row's identity (and therefore the attribution history keyed to it).
model CampaignLessonProduct {
  id                     String    @id @default(cuid())
  brandId                String
  campaignId             String
  lessonId               String
  brandCommerceProductId String
  isActive               Boolean   @default(true)
  displayOrder           Int       @default(0)
  deactivatedAt          DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  brand                Brand                @relation(fields: [brandId], references: [id], onDelete: Cascade)
  lesson               Lesson               @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  // Both composite FKs include brandId, so PostgreSQL itself rejects a
  // cross-brand attachment even if a caller bypasses the application service.
  campaign             Campaign             @relation(fields: [campaignId, brandId], references: [id, brandId], onDelete: Cascade)
  brandCommerceProduct BrandCommerceProduct @relation(fields: [brandCommerceProductId, brandId], references: [id, brandId], onDelete: Cascade)

  commerceClickAttributions CommerceClickAttribution[]

  @@unique([campaignId, lessonId, brandCommerceProductId])
  @@index([lessonId, isActive, displayOrder])
  @@index([campaignId, isActive, displayOrder])
  @@index([brandId, campaignId, isActive])
  @@index([brandCommerceProductId, isActive])
}

/// Phase 6: evidence of ONE outbound commerce click, minted server-side at the
/// moment SQRATCH redirects a visitor to a merchant product page.
///
/// WHAT THIS TABLE IS
/// ------------------
/// A click record, and nothing else. There are deliberately NO money, order,
/// quantity, or conversion columns: this row proves "SQRATCH sent this visitor
/// to this destination, in this campaign context, at this time". Whether a
/// purchase followed is out of scope for Phase 6 and cannot be inferred here.
///
/// TOKEN HANDLING
/// --------------
/// The plaintext click token is generated per request, handed to the browser
/// in the redirect URL, and NEVER persisted — here or in any log. Only
/// `tokenHash` (HMAC-SHA-256, peppered, domain-separated; see
/// `src/lib/commerce/click-token.ts`) is stored, mirroring
/// `EmailVerificationToken.codeHash`. `tokenHash` is unique because it is the
/// only lookup key a future redemption path may use. `tokenPrefix` is a short,
/// non-secret slice kept purely for operator triage (correlating a support
/// report to a row) and is never sufficient to reconstruct the token.
///
/// TRANSPORT REALITY
/// -----------------
/// Phase 12's Shopify Theme App Extension copies the namespaced click token
/// into a cart attribute, and signed Shopify order webhooks may claim the
/// matching hash. This remains prospective, evidence-based attribution only:
/// a token is never accepted from a landing/referrer URL or client request.
///
/// CAMPAIGN CONTEXT
/// ----------------
/// `entryCampaignId` is only ever the campaign resolved SERVER-SIDE from the
/// visitor's trusted Experience-entry context. It records acquisition: a
/// direct Experience entry is deliberately null even when the clicked product
/// is campaign scoped. A campaign id is never accepted from a request.
///
/// `productCampaignId` records the authorization context carried by a
/// campaign-scoped product attachment. It is deliberately independent of
/// `entryCampaignId`: direct entry can click a Campaign A product with
/// `entryCampaignId = null` and `productCampaignId = Campaign A`.
///
/// `entryCampaignContextResolved` distinguishes a deliberate direct/unscoped
/// entry from a trusted campaign entry. It records WHY, not merely whether
/// `entryCampaignId` happens to be null.
///
/// PRODUCT IDENTITY
/// ----------------
/// Every product-identity foreign key is optional, and each is SetNull, so a
/// click survives the deletion of whatever it pointed at.
/// `destinationUrl`/`destinationHost` are the two columns ALWAYS populated.
///
/// PHASE 8 removed the `lessonProductLinkId` / `experienceProductLinkId`
/// columns along with the legacy snapshot tables they referenced. Historical
/// rows whose ONLY structured product identity was one of those two columns
/// therefore keep `destinationUrl`/`destinationHost` but no longer resolve to a
/// product row. That is a recorded, accepted evidence degradation, not a bug:
/// every click minted from Phase 8 onward carries `campaignLessonProductId`
/// and/or `brandCommerceProductId` instead.
///
/// FORWARD SEAM
/// ------------
/// `consumedAt`/`consumedByOrderRef` exist for Phase 7 and are written by no
/// Phase 6 code path. `consumedByOrderRef` is a plain String, NOT a foreign
/// key: no order model exists yet, and inventing one here would prejudge
/// Phase 7's design.
model CommerceClickAttribution {
  id String @id @default(cuid())

  /// HMAC-SHA-256 of the plaintext token. The plaintext is never stored.
  tokenHash   String @unique
  /// Non-secret leading slice of the token, for operator triage only.
  tokenPrefix String

  entryCampaignId              String?
  productCampaignId            String?
  entryCampaignContextResolved Boolean @default(false)

  /// Durable, provider-neutral surface classification, captured once at click
  /// time. Nullable: rows recorded before this column existed have no durable
  /// classification and must be treated as "unknown", never inferred from
  /// which optional FKs happen to still be non-null (that inference is lossy
  /// under CampaignLessonProduct/Campaign deletion — see the migration header).
  /// Never updated after insert.
  surface CommerceClickSurface?

  /// Immutable historical attribution snapshot, captured once at click time.
  /// Deliberately NOT a foreign key: it survives Brand/Campaign deletion and
  /// is never cascaded or reassigned. Brand analytics keys only on this scalar.
  attributedBrandId String?

  experienceId     String
  courseId         String?
  lessonId         String?
  creatorProfileId String?

  brandCommerceProductId  String?
  connectedProductId      String?
  campaignLessonProductId String?
  commerceConnectionId    String?

  /// Always populated. The exact, scheme-validated URL the visitor was sent to.
  destinationUrl  String
  /// Hostname of `destinationUrl`, denormalized so abuse review can group by
  /// destination without parsing every stored URL.
  destinationHost String
  provider        CommerceProvider?

  userId           String?
  sessionId        String?
  qrCodeId         String?
  campaignUnlockId String?

  /// Peppered HMAC of the request IP — never the raw address.
  ipHash    String?
  userAgent String?
  referrer  String?

  createdAt          DateTime  @default(now())
  /// createdAt + 30 days. Bounds how long a token may be presented as evidence.
  expiresAt          DateTime
  /// Set when the redirect is actually issued (Phase 6 writes this).
  redirectedAt       DateTime?
  /// Phase 7 seam. Unused by Phase 6.
  consumedAt         DateTime?
  consumedByOrderRef String?

  // Every relation below is SetNull on delete: a click is historical evidence
  // and must survive the deletion of a campaign, product, or session
  // it referenced. `experience` is the single exception — `experienceId` is
  // required, so Experience deletion cascades (there is no valid orphan state
  // for a required column).
  // Entry/acquisition campaign and product authorization campaign are separate
  // relations. Entry may be a different brand than the clicked product, so it
  // is intentionally a simple FK. Product authorization is separately
  // constrained by canonical assignment tables before a click is minted.
  entryCampaign   Campaign?       @relation("CommerceClickAttributionEntryCampaign", fields: [entryCampaignId], references: [id], onDelete: SetNull)
  productCampaign Campaign?       @relation("CommerceClickAttributionProductCampaign", fields: [productCampaignId], references: [id], onDelete: SetNull)
  experience      Experience      @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  course          Course?         @relation(fields: [courseId], references: [id], onDelete: SetNull)
  lesson          Lesson?         @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  creator         CreatorProfile? @relation(fields: [creatorProfileId], references: [id], onDelete: SetNull)

  brandCommerceProduct  BrandCommerceProduct?     @relation(fields: [brandCommerceProductId], references: [id], onDelete: SetNull)
  connectedProduct      ConnectedCommerceProduct? @relation(fields: [connectedProductId], references: [id], onDelete: SetNull)
  campaignLessonProduct CampaignLessonProduct?    @relation(fields: [campaignLessonProductId], references: [id], onDelete: SetNull)
  commerceConnection    CommerceConnection?       @relation(fields: [commerceConnectionId], references: [id], onDelete: SetNull)

  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  session        UserSession?    @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  qrCode         QRCode?         @relation(fields: [qrCodeId], references: [id], onDelete: SetNull)
  campaignUnlock CampaignUnlock? @relation(fields: [campaignUnlockId], references: [id], onDelete: SetNull)

  /// Phase 7 back-relation for the optional 1:1 in `CommerceOrder.attributionId`.
  /// Optional on both sides: most clicks never become an order, and (per Phase
  /// 6's transport audit) no production order can currently carry a click
  /// token at all.
  order CommerceOrder?

  @@index([entryCampaignId, createdAt])
  @@index([productCampaignId, createdAt])
  @@index([experienceId, createdAt])
  @@index([sessionId, createdAt])
  @@index([userId, createdAt])
  @@index([destinationHost, createdAt])
  @@index([expiresAt])
  @@index([consumedAt])
  // PHASE 10 ANALYTICS INDEXES.
  //
  // The first three serve the durable-brand analytics path: every Brand-side
  // aggregate is keyed on `attributedBrandId`, and the brand-scoped
  // surface breakdown is the flagship query, so it gets its own covering
  // composite. `[surface, createdAt]` serves the operator-level "how are
  // clicks distributed across surfaces platform-wide" read.
  //
  // The remaining five index FK columns that had NO index at all. Beyond the
  // analytics group-bys that need them (top creators / top lessons / top
  // products / QR-sourced clicks), every one of those columns is the target
  // of an ON DELETE SET NULL cascade, each of which currently forces a
  // sequential scan over the whole table whenever the referenced row is
  // deleted.
  @@index([attributedBrandId, createdAt])
  @@index([attributedBrandId, surface, createdAt], map: "CommerceClickAttribution_attributedBrand_surface_createdAt_idx")
  @@index([surface, createdAt])
  @@index([creatorProfileId, createdAt])
  @@index([lessonId, createdAt])
  @@index([brandCommerceProductId, createdAt])
  @@index([connectedProductId, createdAt])
  @@index([qrCodeId, createdAt])
}

/// PHASE 7 — PROVIDER-NEUTRAL ORDER NORMALIZATION
/// ==============================================
/// `CommerceOrder` / `CommerceOrderLineItem` / `CommerceOrderEvent` are the
/// provider-neutral landing zone for merchant order data. They are written
/// only by `src/lib/commerce/order-ingestion.ts`, which is fed by a
/// per-provider pure normalizer (e.g.
/// `src/lib/commerce/providers/shopify-order-normalizer.ts`).
///
/// Phase 12 declares prospective Shopify order/refund topics and `read_orders`.
/// Delivery still requires deployment of that config and merchant
/// reauthorization; see
/// `docs/commerce/phase-12-live-order-ingestion-and-conversion-attribution-summary.md`.
///
/// NO CUSTOMER PII. There is deliberately no email, name, phone, or address
/// column on any model below, and the Shopify normalizer actively skips the
/// `customer` / `billing_address` / `shipping_address` / `email` / `phone`
/// keys. This phase is order/revenue normalization, not customer profiling.
///
/// NO POINTS, NO COMMISSION. These models record what a merchant order WAS.
/// They never award points and never compute a commission — `PointTransaction`,
/// `UserPointAccount`, and every reward model are untouched by Phase 7.
///
/// MONEY IS `BigInt`, NOT `Int` (deliberate divergence from
/// `ConnectedCommerceProduct.priceMinMinor`/`priceMaxMinor`, which are `Int`)
/// ------------------------------------------------------------------------
/// A single product PRICE comfortably fits Postgres `INTEGER` (max
/// 2,147,483,647 minor units ≈ $21.4M at exponent 2), which is why the catalog
/// tables use `Int`. An ORDER TOTAL does not have that guarantee: a wholesale
/// or B2B order, or any 0-exponent currency (JPY, KRW, VND, CLP), can exceed
/// int4 outright. Overflowing produces a Postgres `22003` at write time and
/// loses the order. Every money column here is therefore `BigInt`.
///
/// CONVERTER: order ingestion uses `decimalStringToBigIntMinorUnits` in
/// `src/lib/commerce/money.ts`, which enforces the full int8 range
/// (`INT64_MIN`/`INT64_MAX`) to match these `BigInt` columns. This is a
/// SEPARATE function from `decimalStringToMinorUnits`, which remains
/// int4-bounded (`INT32_MIN`/`INT32_MAX`) and is used only for the `Int`
/// catalog columns (`ConnectedCommerceProduct.priceMinMinor`/`priceMaxMinor`).
/// An amount outside the int8 range still rejects with a typed `OUT_OF_RANGE`
/// result (nulling that one field, never failing the order) — this is now a
/// defense against a genuinely pathological provider value, not a routine
/// limitation, since int8 comfortably covers any realistic order total.
///
/// TOTALS ARE NEVER DERIVED. `totalMinor` is always the provider's own
/// reported total, persisted verbatim. It is never computed by summing
/// converted line items: `decimalStringToBigIntMinorUnits` truncates rather
/// than rounds, so a sum of per-line conversions can legitimately disagree
/// with the provider's total by a few minor units. `netRevenueMinor` is the
/// one derived column (`totalMinor - totalRefundedMinor`), computed at write
/// time.
///
/// IDENTITY IS SCOPED TO THE CONNECTION. `@@unique([connectionId,
/// externalOrderId])`, never a bare unique on `externalOrderId` — two
/// different stores can theoretically mint the same provider order id, and the
/// schema must not assume otherwise (same rule as
/// `ConnectedCommerceProduct.@@unique([connectionId, externalKey])`).
///
/// REDACTION-READY. Every provider-identity string (`externalOrderId`,
/// `orderNumber`, `externalLineItemId`, `externalProductId`,
/// `externalVariantId`, `sku`, `externalOrderRef`) is NULLABLE from day one,
/// so a future `shop/redact` pass can null it without a migration. This is the
/// explicit fix for the documented `ShopifyRewardRedemption.shopifyShopDomain`
/// pain point, where a non-nullable provider column cannot be scrubbed.
///
/// NO COMPOSITE SAME-BRAND FOREIGN KEY. `CampaignCommerceProduct` /
/// `CampaignLessonProduct` / `CommerceClickAttribution` use a composite
/// `(campaignId, brandId) -> Campaign(id, brandId)` key because
/// `Campaign_id_brandId_key` already exists. There is no equivalent
/// `CommerceConnection(id, brandId)` unique key, and creating one would modify
/// a pre-existing table — which this phase's migration deliberately does not
/// do. Cross-brand integrity is instead enforced in the ingestion service,
/// which always reads `brandId` FROM the resolved `CommerceConnection` row
/// rather than accepting it from a caller or a webhook payload.
model CommerceOrder {
  id           String           @id @default(cuid())
  connectionId String
  brandId      String
  provider     CommerceProvider

  /// Provider's own order id. Nullable so redaction can scrub it in place.
  externalOrderId String?
  /// Human-facing order number (e.g. Shopify `order_number`). Not personal data.
  orderNumber     String?

  currencyCode      String?
  /// Minor-unit exponent actually used to convert the amounts below, resolved
  /// via `getCurrencyExponent`. Stored so a later reader never has to guess
  /// which exponent a persisted amount was computed at.
  minorUnitExponent Int?

  subtotalMinor      BigInt?
  discountsMinor     BigInt?
  shippingMinor      BigInt?
  taxMinor           BigInt?
  /// The provider's own reported total. Never derived by summing line items.
  totalMinor         BigInt?
  /// CUMULATIVE refunded amount as of the most recent refund event, not an
  /// incremental delta — see the REFUND SEMANTICS block in
  /// `src/lib/commerce/order-ingestion.ts`. Cumulative makes a replayed refund
  /// webhook idempotent by construction.
  totalRefundedMinor BigInt  @default(0)
  /// Derived at write time: `totalMinor - totalRefundedMinor`. Null whenever
  /// `totalMinor` is null (an unknown total cannot yield a known net).
  netRevenueMinor    BigInt?

  financialStatus   CommerceOrderFinancialStatus?
  fulfillmentStatus CommerceOrderFulfillmentStatus?
  cancelledAt       DateTime?
  cancelReason      String?

  providerCreatedAt DateTime?
  /// The ordering key for out-of-order protection. An incoming event whose
  /// `providerUpdatedAt` is not strictly newer than the stored value never
  /// overwrites the row (the event is recorded as SKIPPED_STALE instead).
  providerUpdatedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  /// Optional 1:1 to the click that produced this order. Populated ONLY when a
  /// payload genuinely carried a durable, hash-matched, redirected, unexpired,
  /// unconsumed click token from the exact Brand/connection/provider. Never
  /// inferred from timing, product overlap, or similarity.
  attributionId String? @unique

  connection  CommerceConnection        @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  brand       Brand                     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  attribution CommerceClickAttribution? @relation(fields: [attributionId], references: [id], onDelete: SetNull)

  lineItems CommerceOrderLineItem[]
  events    CommerceOrderEvent[]

  @@unique([connectionId, externalOrderId])
  @@index([brandId, providerCreatedAt])
  @@index([connectionId, providerUpdatedAt])
  @@index([financialStatus])
}

/// One line of a `CommerceOrder`. Replaced wholesale on a non-stale update:
/// providers report the full line set on every order event, so reconciling
/// individual lines by provider id would preserve lines the provider has since
/// removed. `onDelete: Cascade` from the order is therefore correct — a line
/// item has no meaning without its order.
model CommerceOrderLineItem {
  id      String @id @default(cuid())
  orderId String

  externalLineItemId String?
  externalProductId  String?
  externalVariantId  String?
  /// Best-effort resolution to this brand's synced catalog row. Optional by
  /// design: a merchant can sell a product SQRATCH never synced, and that must
  /// not block ingesting the order. SetNull, not Cascade — deleting a catalog
  /// row must never destroy historical order revenue.
  connectedProductId String?

  title    String?
  sku      String?
  quantity Int

  unitPriceMinor BigInt?
  /// Signed: a discount or adjustment line can legitimately be negative, which
  /// is why the ingestion path uses `decimalStringToBigIntMinorUnits`
  /// (sign-aware, int8-bounded) and NOT `providerPriceStringToMinorUnits`
  /// (rejects negatives by design, int4-bounded).
  discountMinor  BigInt?
  taxMinor       BigInt?
  totalMinor     BigInt?

  createdAt DateTime @default(now())

  order            CommerceOrder             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  connectedProduct ConnectedCommerceProduct? @relation(fields: [connectedProductId], references: [id], onDelete: SetNull)

  @@unique([orderId, externalLineItemId])
  @@index([orderId])
  @@index([connectedProductId])
}

/// One received provider order webhook/event. This is the idempotency ledger:
/// `@@unique([provider, providerEventId])` is what makes a duplicate delivery
/// (same `X-Shopify-Webhook-Id`) a no-op rather than a double-write. A row is
/// written for EVERY delivery, including ones that change no order — a skipped
/// event is still evidence that the event arrived.
model CommerceOrderEvent {
  id           String           @id @default(cuid())
  connectionId String
  brandId      String
  provider     CommerceProvider

  /// Provider's own delivery id (`X-Shopify-Webhook-Id`), or a deterministic
  /// `digest:<sha256>` fallback when the header is absent (fixture-driven
  /// tests have no real header) — see the route handlers.
  providerEventId String
  /// Bound to the ROUTE PATH the delivery arrived on, never to the spoofable
  /// `x-shopify-topic` header.
  topic           String

  /// Provider order id this event referred to. Nullable for redaction, and
  /// deliberately NOT a foreign key: an event can arrive for an order that was
  /// skipped (disconnected shop) and therefore has no row.
  externalOrderRef  String?
  providerUpdatedAt DateTime?

  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  status CommerceOrderEventStatus @default(RECEIVED)

  /// SHA-256 hex digest of the RAW, HMAC-verified webhook body. The body
  /// itself is never persisted — this proves which bytes were processed
  /// without storing any payload content or customer data.
  payloadDigest  String
  /// Short, classified, bounded failure tag. Never an error object, response
  /// body, URL, or payload excerpt.
  failureSummary String?

  /// Optional link to the order this event resolved to, when it resolved to
  /// one. SetNull so the event ledger survives order deletion.
  orderId String?
  order   CommerceOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  connection CommerceConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  brand      Brand              @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([provider, providerEventId])
  @@index([connectionId, receivedAt])
  @@index([brandId, receivedAt])
  @@index([externalOrderRef, providerUpdatedAt])
  @@index([status, receivedAt])
  @@index([orderId])
}

/// PHASE 22 — durable, resumable Commerce7 order reconciliation checkpoint.
/// One row per `CommerceConnection` (created lazily on first use), never in
/// React state or process memory — must survive process termination, page
/// reload, and deployment (see `src/lib/commerce/providers/commerce7-order-reconciliation.ts`
/// for the full state-machine semantics this row backs).
///
/// TWO INDEPENDENT CONCERNS ON ONE ROW, deliberately never conflated:
///   1. `reconciledThrough`/`targetThrough` — the CONTIGUOUS "Catch Up"
///      checkpoint. Everything at or before `reconciledThrough` is proven
///      successfully fetched and idempotently ingested at least once. This
///      is the ONLY field the primary "Catch Up orders" action ever
///      advances, and it only ever advances FORWARD (enforced by a
///      conditional/GREATEST-style update, never a blind overwrite) so a
///      concurrent or out-of-order chunk completion can never move it
///      backwards.
///   2. `customRangeFrom`/`customRangeTo`/`customRangeCursor` — an
///      independent, resumable cursor for an EXPLICIT, admin-requested
///      historical range repair. A custom-range reconciliation NEVER writes
///      `reconciledThrough`/`targetThrough` — reconciling an arbitrary
///      historical window must not be misread as proof the CONTIGUOUS range
///      up to that window is also complete (see the reconciliation
///      service's own header for the exact Aug-5-checkpoint /
///      Aug-20-Aug-21-custom-range example this guards against).
///
/// NO "in progress" boolean flag is stored here on purpose: an age-based
/// "assume abandoned after N minutes" recovery is explicitly forbidden (see
/// the reconciliation service header), and a boolean that could get stuck
/// `true` forever after an interrupted request would invite exactly that
/// temptation. Whether Catch Up still has work to do is always DERIVED by
/// comparing `reconciledThrough` against a freshly-computed target, never
/// read off a persisted "is running" flag — so there is no stuck-flag state
/// to invent unsafe recovery logic for.
model CommerceOrderReconciliationState {
  id           String @id @default(cuid())
  connectionId String @unique
  brandId      String

  /// The durable "reconciled through" watermark. Null means this connection
  /// has never had a successful Catch Up checkpoint established.
  reconciledThrough DateTime?
  /// The upper bound the current (or most recently attempted) Catch Up
  /// sequence is trying to reach. Purely a resumability/UX aid — read again
  /// on page reload so an in-flight Catch Up shows real progress instead of
  /// restarting toward a new "now" on every click. Never itself the
  /// authority for whether a checkpoint advance is safe; only a chunk's own
  /// proven-complete provider result is.
  targetThrough     DateTime?

  lastAttemptedAt DateTime?
  /// "SUCCEEDED" | "PARTIAL" | "FAILED" — informational only, never gates a
  /// decision (mirrors `CommerceProductSyncRun.failureSummary`'s discipline).
  lastRunOutcome  String?
  lastRunError    String?

  /// Independent custom-range repair cursor — see the model doc comment.
  customRangeFrom   DateTime?
  customRangeTo     DateTime?
  customRangeCursor DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  connection CommerceConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  brand      Brand              @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId])
}

model CommerceRewardRedemption {
  id                            String                         @id @default(cuid())
  userId                        String
  brandId                       String
  offerId                       String
  /// Required explicitly by every writer; no provider may silently inherit
  /// Shopify identity from a database default.
  provider                      CommerceProvider
  idempotencyKey                String                         @unique
  code                          String                         @unique
  status                        CommerceRewardRedemptionStatus
  pointsCost                    Int
  discountType                  RewardDiscountType             @default(FIXED_AMOUNT)
  discountAmountCents           Int?
  discountPercentageBasisPoints Int?
  currencyCode                  String                         @default("CAD")
  externalAccountId             String                         @map("shopifyShopDomain")
  externalDiscountId            String?                        @map("shopifyDiscountNodeId")
  externalDiscountStatus        String?                        @map("shopifyDiscountStatus")
  externalUsageCount            Int?                           @map("shopifyAsyncUsageCount")
  providerLastCheckedAt         DateTime?                      @map("shopifyLastCheckedAt")
  issuedAt                      DateTime?
  expiresAt                     DateTime?
  usedAt                        DateTime?
  errorMessage                  String?
  providerErrorDetails          Json?                          @map("shopifyUserErrors")
  createdAt                     DateTime                       @default(now())
  updatedAt                     DateTime                       @updatedAt
  reconcileLockedUntil          DateTime?
  reconcileAttempts             Int                            @default(0)
  needsManualReview             Boolean                        @default(false)
  lastReconcileReason           String?
  brand                         Brand                          @relation(fields: [brandId], references: [id], onDelete: Cascade)
  offer                         BrandRewardOffer               @relation(fields: [offerId], references: [id], onDelete: Restrict)
  pointTransactions             PointTransaction[]
  user                          User                           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([brandId, createdAt])
  @@index([offerId])
  @@index([status])
  @@index([status, needsManualReview, createdAt])
  @@index([offerId, status])
  @@index([offerId, userId, status])
  /// Phase 15C2 uses this exact historical identity to resolve the matching
  /// connection; it must never call a current connection for another account.
  @@index([brandId, provider, externalAccountId], map: "ShopifyRewardRedemption_brandId_provider_shopifyShopDomain_idx")
  @@map("ShopifyRewardRedemption")
}

model UserSession {
  id                        String                     @id
  createdAt                 DateTime                   @default(now())
  lastSeenAt                DateTime                   @default(now())
  userId                    String?
  anonKey                   String?                    @unique
  campaignId                String?
  qrCodeId                  String?
  analyticsEvents           AnalyticsEvent[]
  lessonProgress            LessonProgress[]
  campaign                  Campaign?                  @relation(fields: [campaignId], references: [id])
  qrCode                    QRCode?                    @relation(fields: [qrCodeId], references: [id])
  user                      User?                      @relation(fields: [userId], references: [id])
  commerceClickAttributions CommerceClickAttribution[]

  @@index([userId])
  @@index([anonKey])
  @@index([campaignId])
  @@index([qrCodeId])
}

model AnalyticsEvent {
  id           String       @id @default(cuid())
  name         String
  createdAt    DateTime     @default(now())
  brandId      String?
  campaignId   String?
  qrCodeId     String?
  experienceId String?
  courseId     String?
  lessonId     String?
  userId       String?
  sessionId    String?
  pagePath     String?
  referrer     String?
  userAgent    String?
  ipHash       String?
  country      String?
  region       String?
  city         String?
  data         Json?
  brand        Brand?       @relation(fields: [brandId], references: [id])
  campaign     Campaign?    @relation(fields: [campaignId], references: [id])
  course       Course?      @relation(fields: [courseId], references: [id])
  experience   Experience?  @relation(fields: [experienceId], references: [id])
  lesson       Lesson?      @relation(fields: [lessonId], references: [id])
  qrCode       QRCode?      @relation(fields: [qrCodeId], references: [id])
  session      UserSession? @relation(fields: [sessionId], references: [id])
  user         User?        @relation(fields: [userId], references: [id])

  @@index([name, createdAt])
  @@index([brandId])
  @@index([campaignId])
  @@index([qrCodeId])
  @@index([experienceId])
  @@index([lessonId])
  @@index([userId])
  @@index([sessionId])
}

model EmailVerificationToken {
  id              String    @id @default(cuid())
  userId          String
  email           String
  codeHash        String
  welcomeEligible Boolean   @default(false)
  failedAttempts  Int       @default(0)
  consumedAt      DateTime?
  expires         DateTime
  createdAt       DateTime  @default(now())
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([email])
  @@index([userId, consumedAt, expires])
  @@index([email, consumedAt, expires])
}

model TokenStore {
  service   String   @id
  token     String
  expiresAt DateTime
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

model EmailQueue {
  id                   BigInt        @id @default(autoincrement())
  userId               String
  email                String
  status               EmailStatus   @default(PENDING)
  attempts             Int           @default(0)
  lastError            String?
  nextAttemptAt        DateTime?
  claimedAt            DateTime?
  createdAt            DateTime      @default(now())
  sentAt               DateTime?
  template             EmailTemplate
  verificationEligible Boolean       @default(false)
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, template], name: "uq_email_queue_user_template")
  @@index([status, createdAt], map: "idx_email_queue_status_created")
  @@index([template, status, nextAttemptAt, createdAt], map: "idx_email_queue_ready")
  @@index([template, status, claimedAt], map: "idx_email_queue_stale_claim")
}

model WaitlistEntry {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String?
  ip        String?
  createdAt DateTime @default(now())
}

model PointTransaction {
  id                         String                    @id @default(cuid())
  userId                     String
  points                     Int
  reason                     PointReason
  qrCodeId                   String?
  commerceRewardRedemptionId String?                   @map("shopifyRewardRedemptionId")
  createdAt                  DateTime                  @default(now())
  type                       PointTransactionType      @default(EARN)
  sourceType                 PointSourceType?
  sourceId                   String?
  idempotencyKey             String?
  metadata                   Json?
  balanceAfter               Int?
  lifetimeEarnedAfter        Int?
  createdById                String?
  qrCode                     QRCode?                   @relation(fields: [qrCodeId], references: [id])
  commerceRewardRedemption   CommerceRewardRedemption? @relation(fields: [commerceRewardRedemptionId], references: [id], onDelete: SetNull, map: "PointTransaction_shopifyRewardRedemptionId_fkey")
  user                       User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, qrCodeId])
  @@unique([commerceRewardRedemptionId, reason], name: "uq_point_tx_redemption_reason", map: "PointTransaction_shopifyRewardRedemptionId_reason_key")
  @@unique([userId, idempotencyKey], name: "uq_point_tx_user_idempotency_key", map: "uq_point_tx_user_idempotency_key")
  @@index([userId])
  @@index([qrCodeId])
  @@index([commerceRewardRedemptionId], map: "PointTransaction_shopifyRewardRedemptionId_idx")
  @@index([userId, createdAt])
  @@index([sourceType, sourceId])
}

model UserPointAccount {
  userId                 String   @id
  spendablePoints        Int      @default(0)
  lifetimeEarnedPoints   Int      @default(0)
  lifetimeSpentPoints    Int      @default(0)
  lifetimeRefundedPoints Int      @default(0)
  version                Int      @default(0)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([lifetimeEarnedPoints])
  @@index([spendablePoints])
}

