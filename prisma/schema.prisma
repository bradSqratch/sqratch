model PointTransaction {
  id                        String                   @id @default(cuid())
  userId                    String
  points                    Int
  reason                    PointReason
  qrCodeId                  String?
  shopifyRewardRedemptionId String?
  createdAt                 DateTime                 @default(now())
  type                      PointTransactionType     @default(EARN)
  sourceType                PointSourceType?
  sourceId                  String?
  idempotencyKey            String?
  metadata                  Json?
  balanceAfter              Int?
  lifetimeEarnedAfter       Int?
  createdById               String?
  qrCode                    QRCode?                  @relation(fields: [qrCodeId], references: [id])
  shopifyRewardRedemption   ShopifyRewardRedemption? @relation(fields: [shopifyRewardRedemptionId], references: [id], onDelete: SetNull)
  user                      User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, qrCodeId])
  @@unique([shopifyRewardRedemptionId, reason], name: "uq_point_tx_redemption_reason")
  @@unique([userId, idempotencyKey], name: "uq_point_tx_user_idempotency_key", map: "uq_point_tx_user_idempotency_key")
  @@index([userId])
  @@index([qrCodeId])
  @@index([shopifyRewardRedemptionId])
  @@index([userId, createdAt])
  @@index([sourceType, sourceId])
}

model UserPointAccount {
  userId                 String   @id
  spendablePoints        Int      @default(0)
  lifetimeEarnedPoints   Int      @default(0)
  lifetimeSpentPoints    Int      @default(0)
  lifetimeRefundedPoints Int      @default(0)
  version                Int      @default(0)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([lifetimeEarnedPoints])
  @@index([spendablePoints])
}

